DJANGO_SECRET_KEY="secret-key" # change this
DB_NAME=heedless_backbones
DB_USER=django
DB_PASS=pass # change this
DB_HOST=localhost
DB_PORT=5432

# Paper ingestion. Screening and full reads run in local Claude Code sessions on your
# claude.ai login (API keys are removed from their environment). No scheduler is enabled
# by these settings.
INGESTION_MAX_SCREENS=25
INGESTION_MAX_PAPERS=3
# Optional Claude Code models (default: Claude Code's configured model).
# INGESTION_MODEL=
# INGESTION_SCREEN_MODEL=
ARXIV_TROLLER_URL=https://arxiv-troller.com
ARXIV_TROLLER_ACCOUNT=your-account-string
ARXIV_TROLLER_SOURCE_TAG=backbones
ARXIV_TROLLER_TAG=heedless-backbones
# Optional private artifact directory (default: ingestion_data/ in the repository).
# INGESTION_STORAGE=/path/to/private/ingestion_data
# Optional reference YAML directory (default: family_data/ in the repository).
# FAMILY_DATA_DIR=/path/to/family_data
