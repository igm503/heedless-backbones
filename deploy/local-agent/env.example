# Copy to ~/.config/heedless-agent/env (chmod 600). Read by run.sh.
SSH_HOST=oracle
PYTHON=/path/to/venv/bin/python
# The server's database (reached through an SSH tunnel on TUNNEL_PORT).
DB_NAME=heedless_backbones
DB_USER=django
DB_PASS=...
TUNNEL_PORT=55432
# Private paper storage on this Mac, and the server's INGESTION_STORAGE.
INGESTION_STORAGE=$HOME/.local/share/heedless-agent
REMOTE_STORAGE=/home/django/heedless-backbones/ingestion_data
# The server's Django directory and settings, for publishing there (defaults shown).
REMOTE_DJANGO=/home/django/heedless-backbones/django
REMOTE_SETTINGS=heedless-backbones.settings_django_deploy
# Scheduled runs use this checkout of origin/main (created by install.sh; default shown).
# AGENT_REPO=$HOME/.local/share/heedless-agent/repo
# Any value; only local Django needs it (the agent's checkout has no .env).
DJANGO_SECRET_KEY=...
# Papers read in full per run, abstracts screened per run, and whether to publish.
LIMIT=5
SCREEN_LIMIT=25
PUBLISH=1
# Discovery account on Arxiv Troller.
ARXIV_TROLLER_ACCOUNT=your-account-string
# Claude Code must be logged in (run `claude` once); API keys are ignored for its sessions.
