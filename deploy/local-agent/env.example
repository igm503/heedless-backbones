# Copy to ~/.config/heedless-agent/env (chmod 600). Read by run.sh.
SSH_HOST=oracle
PYTHON=/path/to/venv/bin/python
# The server's database (reached through an SSH tunnel on TUNNEL_PORT).
DB_NAME=heedless_backbones
DB_USER=django
DB_PASS=...
TUNNEL_PORT=55432
# Private paper storage on this Mac, and the server's INGESTION_STORAGE.
INGESTION_STORAGE=$HOME/.local/share/heedless-agent
REMOTE_STORAGE=/home/django/heedless-backbones/ingestion_data
# Papers read in full per run, abstracts screened per run, and whether to publish.
LIMIT=5
SCREEN_LIMIT=25
PUBLISH=1
# Also needed (e.g. in the repository's .env): ARXIV_TROLLER_ACCOUNT for discovery.
# Claude Code must be logged in (run `claude` once); API keys are ignored for its sessions.
